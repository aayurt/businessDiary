{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "clean": "npm run clean --workspaces --if-present"
  },
  "workspaces": [
    "packages/*"
  ]
}

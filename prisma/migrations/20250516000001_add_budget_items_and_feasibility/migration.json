        "primaryKey": { "columns": ["id"] }
      }
    },
    {
      "tag": "CreateTable",
      "table": {
        "name": "FeasibilityEntry",
        "columns": [
          { "name": "id", "type": "TEXT", "default": { "name": "cuid" }, "autoincrement": false },
          { "name": "fileId", "type": "TEXT", "isRequired": true },

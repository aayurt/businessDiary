          { "name": "id", "type": "TEXT", "default": { "name": "cuid" }, "autoincrement": false },
          { "name": "fileId", "type": "TEXT", "isRequired": true },
          { "name": "label", "type": "TEXT", "isRequired": true },
          { "name": "amount", "type": "DOUBLE PRECISION", "isRequired": true },
          { "name": "type", "type": "TEXT", "isRequired": true },
          { "name": "createdById", "type": "TEXT", "isRequired": false },
          { "name": "createdAt", "type": "TIMESTAMP(3)", "default": { "name": "now" }, "isRequired": true }
